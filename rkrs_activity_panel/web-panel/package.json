{
  "name": "rkrs-activity-web-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixtures": "vite --host 127.0.0.1 --mode fixtures",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
