# Режим данных: live | hybrid | fixtures (см. README).
# Пусто: dev-сервер — hybrid, production-сборка — live.
VITE_DATA_MODE=

# --- Только для dev-сервера Vite, НЕ попадает в сборку (нет префикса VITE_) ---
# Origin Core API amocrm-pro, на который dev-сервер проксирует /api/v1/activity/*.
ACTIVITY_API_ORIGIN=http://127.0.0.1:8080
# Management API требует серверный токен. Dev-прокси подставляет его сам,
# браузер токен не видит. Без этих значений серверные настройки панелей
# в live-режиме показываются как неподключённые.
ACTIVITY_MANAGEMENT_TOKEN=
ACTIVITY_INSTALLATION_ID=
ACTIVITY_INTEGRATION_ID=
